rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Versión personal: un solo usuario. Solo el uid de Pedro lee y escribe,
    // y únicamente dentro de su propio documento (incluye users/{uid}/months/*).
    // OJO: el proyecto fitness-tracker-b46ad es compartido con la app comercial
    // pausada. Estas reglas cortan sharedFoods/leaderboard y el acceso de otros
    // usuarios. Para retomar la comercial, re-deployar sus reglas desde
    // albap8668-sketch/Fitness.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == "27kSUTAXhpg7NPO342S7XXPjwHn1"
        && userId == request.auth.uid;
    }

    // Todo lo demás denegado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
